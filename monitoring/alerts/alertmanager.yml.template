global:
  resolve_timeout: 5m

route:
  receiver: uptimehub-email
  group_by:
    - alertname
    - severity

  group_wait: 10s
  group_interval: 5m
  repeat_interval: 1h

receivers:
  - name: uptimehub-email

    email_configs:
      - to: "${ALERT_EMAIL_TO}"

        from: "${ALERT_EMAIL_FROM}"

        smarthost: "smtp.gmail.com:587"

        auth_username: "${ALERT_EMAIL_FROM}"
        auth_password: "${ALERT_EMAIL_PASSWORD}"

        require_tls: true

        send_resolved: true
